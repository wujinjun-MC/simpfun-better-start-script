# Auto color
alias ip='ip --color=auto '

# Safety
alias rm="safe-rm "

# Tmux
alias att="tmux attach "
alias satt="sudo tmux attach "

# ls
alias lal="ls -Al"
alias lald="ls -Ald"
alias ll="ls -Al --classify=auto"
alias ls="ls --hyperlink=auto --color=auto --time-style=full-iso"

# tree
alias treex="tree -af -pug -s -D -F --inodes"
